{
  "mailin": {
    "host": "0.0.0.0",
    "port": 25,
    "disableWebhook": true
  },
  "web": {
    "port": 3000
  },
  "storage": {
    "path": "./data/forsaken-mail.sqlite",
    "maxMailsPerInbox": 100,
    "mailTtlHours": 48,
    "maxBodyChars": 200000
  },
  "auth": {
    "ownerPassword": "",
    "statePath": "./data/auth-state.json",
    "sessionTtlHours": 168,
    "requireHttps": false,
    "trustProxy": false
  },
  "host": "mail.example.com",
  "keywordBlackList": ["admin", "postmaster", "system", "webmaster", "administrator", "hostmaster", "service", "server", "root"]
}
